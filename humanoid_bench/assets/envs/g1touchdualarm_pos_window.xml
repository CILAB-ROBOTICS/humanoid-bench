<mujoco model="g1touchdualarm_pos_window">
    <option timestep="0.002" iterations="100" ls_iterations="50" solver="Newton">
        <flag eulerdamp="enable"/>
    </option>
    <include file="../common/visual.xml"/>
    <include file="../common/floor.xml"/>
    <include file="../robots/g1touchdualarm_pos.xml"/>
    <include file="../tasks/window.xml"/>

    <equality>
        <weld name="fix_robot" body1="world" body2="pelvis"/>

        <weld name="fix_tool_left" body1="left_base_link" body2="tool_handle_left"
              solref="0.005 1" solimp="0.99 0.95 0.001 0.5 2"/>
        <weld name="fix_tool_right" body1="right_base_link" body2="tool_handle_right"
              solref="0.005 1" solimp="0.99 0.95 0.001 0.5 2"/>
    </equality>
</mujoco>